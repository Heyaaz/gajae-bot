{
  "name": "agent-control",
  "productName": "Gajae",
  "private": true,
  "version": "0.1.0",
  "description": "A native macOS desktop client for GJC coding-agent sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Heyaaz/gajae-bot.git"
  },
  "homepage": "https://github.com/Heyaaz/gajae-bot#readme",
  "bugs": {
    "url": "https://github.com/Heyaaz/gajae-bot/issues"
  },
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json --noEmit",
    "clean": "node scripts/clean-desktop.mjs",
    "build": "npm run clean && npm run typecheck && vite build && tsc -p electron/tsconfig.json && npm run build:preload",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload.cjs",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke",
    "desktop:gjc-smoke": "electron . --gjc-smoke",
    "desktop:offline-smoke": "electron scripts/offline-shell-smoke.mjs",
    "desktop:attachment-smoke": "electron scripts/attachment-render-smoke.mjs",
    "desktop:inspector-smoke": "electron scripts/inspector-open-smoke.mjs",
    "desktop:clean-install-smoke": "node scripts/packaged-clean-install-smoke.mjs",
    "package:mac": "node package-mac.mjs",
    "gjc:e2e": "npm run build && node scripts/gjc-sdk-e2e.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "verify": "npm run lint && npm test && npm run build && npm run desktop:smoke && npm run desktop:offline-smoke && npm run desktop:attachment-smoke && npm run desktop:inspector-smoke && npm run desktop:gjc-smoke",
    "verify:gjc": "npm run build && npm run desktop:gjc-smoke && node scripts/gjc-sdk-e2e.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.10",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
